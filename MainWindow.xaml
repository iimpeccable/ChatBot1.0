<Window x:Class="ChatBot1._0GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Awareness Bot" Height="600" Width="800"
        Background="#1E1E1E" Foreground="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
           Text="=== Invictus ==="
           FontFamily="Segoe UI"
           FontSize="22"
           FontWeight="Bold"
           Foreground="White"
           TextAlignment="Center"
           Padding="10">
            <TextBlock.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6A0DAD" Offset="0"/>
                    <GradientStop Color="#8A2BE2" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Background>
        </TextBlock>

        <!-- Chat History -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#252526">
            <StackPanel x:Name="ChatHistoryPanel" Margin="10"/>
        </ScrollViewer>

        <!-- Input -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="UserInput"
                     Width="600" Height="40"
                     FontSize="14"
                     Background="#333"
                     Foreground="White"
                     BorderBrush="#6A0DAD"
                     BorderThickness="2"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"/>
            <Button Content="Send"
                    Width="120" Height="40"
                    Background="#6A0DAD"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>
